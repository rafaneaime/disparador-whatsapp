# Connection string do Neon (neon.tech). A integracao do botao de deploy
# preenche esta sozinha.
DATABASE_URL=

# Senha para entrar no painel. Voce inventa.
PANEL_PASSWORD=

# --- A conexao com a Meta -------------------------------------------------
# Todas em WhatsApp > Configuracao da API, no painel do seu aplicativo Meta.
# O painel sobe sem elas e mostra o que falta — preencha depois do primeiro
# deploy, porque a Meta precisa da URL que so existe depois dele.

# Botao "Gerar" na Configuracao da API. O token temporario vence em HORAS,
# nao em um dia: para valer, crie o permanente por usuario do sistema.
WHATSAPP_ACCESS_TOKEN=

# "Identificacao do numero de telefone", logo abaixo do numero de teste.
WHATSAPP_PHONE_NUMBER_ID=

# "Identificacao da conta do WhatsApp Business", logo abaixo da anterior.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Opcional. Fixa a versao da Graph API; sem ela, usamos uma versao conhecida.
WHATSAPP_GRAPH_API_VERSION=

# --- Opcionais ------------------------------------------------------------
# So para receber os estados "entregue" e "lida". O envio funciona sem.
# Configuracoes do app > Basico > Chave secreta do aplicativo.
META_APP_SECRET=

# Protege a rota de cron. A Vercel envia como Bearer automaticamente.
CRON_SECRET=

# E-mail que aparece na sua politica de privacidade, para quem quiser pedir
# a remocao dos proprios dados.
EMAIL_CONTATO=
